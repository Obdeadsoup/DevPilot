<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.obdeadsoup</groupId>
    <artifactId>devpilot</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DevPilot</name>
    <description>GitHub project collaboration and AI engineering assistant</description>

    <modules>
        <module>devpilot-task</module>
        <module>devpilot-framework</module>
        <module>devpilot-identity</module>
        <module>devpilot-project</module>
        <module>devpilot-github</module>
        <module>devpilot-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.obdeadsoup</groupId>
                <artifactId>devpilot-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.obdeadsoup</groupId>
                <artifactId>devpilot-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.obdeadsoup</groupId>
                <artifactId>devpilot-project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.obdeadsoup</groupId>
                <artifactId>devpilot-task</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.obdeadsoup</groupId>
                <artifactId>devpilot-github</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
