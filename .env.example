DEVPILOT_REDIS_HOST=127.0.0.1
DEVPILOT_REDIS_PORT=6380
DEVPILOT_REDIS_PASSWORD=

# Referenced by a local dp_github_repository.credential_ref value when a binding is prepared manually.
