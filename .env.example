# Copy this file to .env and replace every password before local startup.
DEVPILOT_MYSQL_HOST=127.0.0.1
DEVPILOT_MYSQL_PORT=3307
DEVPILOT_MYSQL_DATABASE=devpilot
DEVPILOT_MYSQL_USERNAME=devpilot
DEVPILOT_MYSQL_PASSWORD=123456
DEVPILOT_MYSQL_ROOT_PASSWORD=123456

DEVPILOT_REDIS_HOST=127.0.0.1
DEVPILOT_REDIS_PORT=6380
DEVPILOT_REDIS_PASSWORD=

# Store only these environment variable names in repository bindings; never store their values in MySQL.
DEVPILOT_GITHUB_API_TOKEN_LOCAL=
DEVPILOT_GITHUB_WEBHOOK_SECRET_LOCAL=

# Python agent-service 的 DeepSeek 手工 smoke；只在本机 .env 或进程环境中填写真实 Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
