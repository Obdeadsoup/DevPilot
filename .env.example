# Copy to .env. Replace required placeholders locally; never commit .env.

# MySQL
DEVPILOT_MYSQL_HOST=127.0.0.1
DEVPILOT_MYSQL_PORT=3307
DEVPILOT_MYSQL_DATABASE=devpilot
DEVPILOT_MYSQL_USERNAME=devpilot
DEVPILOT_MYSQL_PASSWORD=
DEVPILOT_MYSQL_ROOT_PASSWORD=

# Redis
DEVPILOT_REDIS_HOST=127.0.0.1
DEVPILOT_REDIS_PORT=6380
DEVPILOT_REDIS_PASSWORD=

# Full Compose
DEVPILOT_WEB_PORT=5173
DEVPILOT_GATEWAY_PORT=8081
DEVPILOT_CORE_PORT=8080
DEVPILOT_MAILPIT_PORT=8025
# Generate an independent random value of at least 16 characters; Java and Python share it.
DEVPILOT_AGENT_TOOL_SERVICE_KEY=

# Mail
# Full Compose overrides the SMTP endpoint to mailpit:1025. These values support direct smtp/prod runs.
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=your_email@qq.com
MAIL_AUTH_ENABLED=true
MAIL_SSL_ENABLED=true
MAIL_STARTTLS_ENABLED=false
MAIL_HEALTH_ENABLED=false

# GitHub local/demo (optional until repository binding)
# Bindings store these variable names as references; their values never enter MySQL or API responses.
DEVPILOT_GITHUB_API_TOKEN_LOCAL=
DEVPILOT_GITHUB_WEBHOOK_SECRET_LOCAL=

# DeepSeek (required by the full profile; fake mode is never used by Full Compose)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=2
DEEPSEEK_READ_TIMEOUT_SECONDS=30
DEEPSEEK_OVERALL_TIMEOUT_SECONDS=30

# Agent internal gRPC
DEVPILOT_AGENT_GRPC_HOST=localhost
DEVPILOT_AGENT_GRPC_PORT=50051
DEVPILOT_AGENT_GRPC_DEADLINE=30s
DEVPILOT_AGENT_GRPC_STREAM_DEADLINE=10m
DEVPILOT_AGENT_GRPC_CANCEL_DEADLINE=3s
DEVPILOT_AGENT_GRPC_PLAINTEXT=true
DEVPILOT_AGENT_MAX_ACTIVE_RUNS=20
DEVPILOT_AGENT_CIRCUIT_WINDOW_SIZE=10
DEVPILOT_AGENT_CIRCUIT_MINIMUM_CALLS=5
DEVPILOT_AGENT_CIRCUIT_FAILURE_RATE=50
DEVPILOT_AGENT_CIRCUIT_OPEN_DURATION=10s
DEVPILOT_AGENT_CIRCUIT_HALF_OPEN_CALLS=2
DEVPILOT_AGENT_TOOL_GRPC_ENABLED=false
DEVPILOT_AGENT_TOOL_GRPC_HOST=127.0.0.1
DEVPILOT_AGENT_TOOL_GRPC_PORT=50052
DEVPILOT_JAVA_TOOL_GRPC_TARGET=127.0.0.1:50052
DEVPILOT_JAVA_TOOL_GRPC_DEADLINE_SECONDS=3
DEVPILOT_JAVA_TOOL_GRPC_MAX_MESSAGE_BYTES=65536
DEVPILOT_JAVA_TOOL_GRPC_MAX_RESULT_BYTES=65536
DEVPILOT_JAVA_TOOL_CIRCUIT_FAILURE_THRESHOLD=3
DEVPILOT_JAVA_TOOL_CIRCUIT_OPEN_SECONDS=10
AGENT_GRPC_HOST=0.0.0.0
AGENT_GRPC_PORT=50051
AGENT_MODEL_MODE=deepseek
AGENT_FAKE_DELAY_SECONDS=0
# Relative to the Python process working directory; Compose uses its own persistent /app/data volume.
AGENT_RUNTIME_DB_PATH=.runtime/agent-runtime.sqlite3

# Nacos
DEVPILOT_NACOS_SERVER_ADDR=127.0.0.1:8848
DEVPILOT_NACOS_NAMESPACE=
DEVPILOT_NACOS_GROUP=DEVPILOT
DEVPILOT_NACOS_CONFIG_ENABLED=false
DEVPILOT_NACOS_DISCOVERY_ENABLED=false
DEVPILOT_NACOS_CONSOLE_PORT=8082
DEVPILOT_NACOS_PORT=8848
DEVPILOT_NACOS_GRPC_PORT=9848
# Only used if production enables Nacos authentication; local Full Compose is auth-disabled.
DEVPILOT_NACOS_AUTH_TOKEN=
DEVPILOT_NACOS_AUTH_IDENTITY_KEY=
DEVPILOT_NACOS_AUTH_IDENTITY_VALUE=

# Frontend/Gateway
DEVPILOT_GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8081
